#!/usr/bin/env node
// ember-ascii — render an Ember Field recipe as braille text art, e.g. for a fastfetch logo.
'use strict';
const fs = require('fs'), path = require('path');
const Ember = require(path.join(fs.realpathSync(__dirname), '..', 'emberfield.js'));

const HELP = `usage: ember-ascii [recipe] [--rows N] [--cols N] [--gain X] [--out file] [--ansi]

  recipe      an ember1:... code (omit it for the default emblem)
  --rows N    height in text lines, default 18
  --cols N    width in characters, default 2 × rows
  --gain X    brightness multiplier for the dots, default 3.5
  --floor X   brightness below which no dots are drawn, default 0.3
  --contrast X  0 = hard edges, 1 = full dithering, default 0.25
  --out FILE  write to a file instead of stdout
  --ansi      colour with 24-bit ANSI escapes (for viewing in a terminal) instead of
              fastfetch's $1–$4 markers. Marker colours map to logo.color "1"–"4".`;

const args = process.argv.slice(2);
let recipe = 'ember1:s77,f1.2,o4,v3,w1,p30,l400,e0.45,g0.5,ccrimson,mring';
let rows = 18, cols = null, gain = 3.5, floor = 0.3, contrast = 0.25, out = null, ansi = false;
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a === '-h' || a === '--help') { console.log(HELP); process.exit(0); }
  else if (a === '--rows') rows = +args[++i];
  else if (a === '--cols') cols = +args[++i];
  else if (a === '--gain') gain = +args[++i];
  else if (a === '--floor') floor = +args[++i];
  else if (a === '--contrast') contrast = +args[++i];
  else if (a === '--out') out = args[++i];
  else if (a === '--ansi') ansi = true;
  else if (a.startsWith('ember1:')) recipe = a;
  else { console.error(`ember-ascii: unknown argument "${a}"\n\n${HELP}`); process.exit(2); }
}
cols = cols || rows * 2;
if (!(rows > 0 && cols > 0)) { console.error('ember-ascii: --rows and --cols must be positive'); process.exit(2); }

// Each braille character is a 2×4 grid of dots. Supersample, then box-average down to dots.
const SS = 5, DW = cols * 2, DH = rows * 4, W = DW * SS, H = DH * SS;
const params = Ember.parse(recipe);
const r = Ember.createRenderer(params, W, H);
r.trace(Infinity);
const px = r.toValues(new Float32Array(W * H));
const dots = new Float32Array(DW * DH), raw = new Float32Array(DW * DH);
for (let y = 0; y < DH; y++) for (let x = 0; x < DW; x++) {
  let s = 0;
  for (let j = 0; j < SS; j++) for (let i = 0; i < SS; i++) s += px[(y * SS + j) * W + x * SS + i];
  raw[y * DW + x] = s / (SS * SS);
  dots[y * DW + x] = Math.min(1, raw[y * DW + x] * gain);
}

// Ordered dithering turns brightness into dot coverage; a floor keeps faint haze off the art.
const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map(v => (v + 0.5) / 16);
// contrast squeezes the dither band: 1 = full ordered dither, 0 = hard threshold at the midpoint.
const lit = (x, y) => {
  const v = (dots[y * DW + x] - floor) / (1 - floor);
  return v > 0.5 + (BAYER[(y & 3) * 4 + (x & 3)] - 0.5) * contrast;
};
const BIT = [[0x01, 0x08], [0x02, 0x10], [0x04, 0x20], [0x40, 0x80]];

// Four colour levels from the recipe's palette (skipping the background stop).
const stops = Ember.PALETTES[params.c].slice(1);
const pick = n => stops[Math.min(stops.length - 1, Math.round(n * (stops.length - 1)))][1];
const LEVELS = [pick(0), pick(0.34), pick(0.67), pick(1)];
const rgb = h => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16)).join(';');

// Pass 1: dot pattern and raw brightness per character.
const cells = [];
for (let cy = 0; cy < rows; cy++) for (let cx = 0; cx < cols; cx++) {
  let bits = 0, sum = 0, n = 0;
  for (let dy = 0; dy < 4; dy++) for (let dx = 0; dx < 2; dx++) {
    const x = cx * 2 + dx, y = cy * 4 + dy;
    if (lit(x, y)) { bits |= BIT[dy][dx]; sum += raw[y * DW + x]; n++; }
  }
  cells.push({ bits, m: n ? sum / n : 0 });
}
// Colour by rank, so the levels stay balanced whatever the gain:
// faintest 25% deep, 40% mid, 25% bright, hottest 10% white.
const ms = cells.filter(c => c.bits).map(c => c.m).sort((a, b) => a - b);
const q = f => ms.length ? ms[Math.min(ms.length - 1, Math.floor(f * ms.length))] : 0;
const cut = [q(0.25), q(0.65), q(0.9)];

const lines = [];
for (let cy = 0; cy < rows; cy++) {
  let line = '', cur = -1;
  for (let cx = 0; cx < cols; cx++) {
    const { bits, m } = cells[cy * cols + cx];
    if (bits) {
      const lvl = m < cut[0] ? 0 : m < cut[1] ? 1 : m < cut[2] ? 2 : 3;
      if (lvl !== cur) { line += ansi ? `\x1b[38;2;${rgb(LEVELS[lvl])}m` : '$' + (lvl + 1); cur = lvl; }
    }
    line += String.fromCharCode(0x2800 + bits);
  }
  lines.push(line + (ansi ? '\x1b[0m' : ''));
}
const text = lines.join('\n') + '\n';
if (out) {
  fs.writeFileSync(out, text);
  if (!ansi) console.log(`wrote ${out} (${cols}×${rows}). fastfetch colours: ` + LEVELS.map((h, i) => `"${i + 1}": "38;2;${rgb(h)}"`).join(', '));
} else process.stdout.write(text);
